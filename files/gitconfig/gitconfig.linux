[includeIf "gitdir/i:~/dev/personal/"]
	path = .gitconfig-personal

[includeIf "gitdir/i:~/roar/"]
	path = .gitconfig-work

[init]
	#templatedir = $HOME/.git_template
	defaultBranch = main
[alias]
	ctags = !.git/hooks/ctags
	co = commit
	st = status
[core]
	excludesFile = /home/dgarcia/.gitignore_global
	editor = vim
	ignoreCase = false
[diff]
	tool = vimdiff
[difftool]
	prompt = false
[difftool "vimdiff"]
	path = /usr/local/bin/vim
[fetch]
    prune = true
[pull]
    rebase = true
